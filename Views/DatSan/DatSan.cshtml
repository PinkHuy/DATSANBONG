@model DATSANBONG.Models.DatSanFormViewModel

@{
    ViewBag.Title = "Đặt sân - " + Model.TenSan;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="dsb-section min-vh-100 text-white py-5">
    <div class="container">
        <!-- Breadcrumb -->
        <div class="mb-4">
            <a href="@Url.Action("Detail", "SanBong", new { id = Model.MaSan })" class="text-success text-decoration-none fw-bold">
                <i class="bi bi-arrow-left me-1"></i> Quay lại chi tiết sân
            </a>
        </div>

        <div class="row g-4">
            <!-- Cột bên trái: col-lg-5 chứa cả "Thông tin sân" và "Form đặt sân" -->
            <div class="col-lg-5 d-flex flex-column gap-4">
                
                <!-- Panel 1: Thông tin sân bóng (Readonly preview) -->
                <div class="bg-dark p-4 rounded-4 border border-secondary border-opacity-25 shadow-lg">
                    <h3 class="fw-bold mb-3 text-white fs-5">
                        <i class="bi bi-info-circle text-success me-2"></i>Thông Tin Sân Bóng
                    </h3>
                    <div class="rounded-3 overflow-hidden mb-3" style="width: 100%; aspect-ratio: 16/9; overflow: hidden; background: #1c2128;">
                        @if (string.IsNullOrEmpty(Model.HinhAnh))
                        {
                            <img src="~/Content/Images/default-field.jpg" class="w-100 h-100 object-fit-cover" alt="@Model.TenSan" />
                        }
                        else
                        {
                            <img src="~/Content/Images/SanBong/@Model.HinhAnh" class="w-100 h-100 object-fit-cover" alt="@Model.TenSan" />
                        }
                    </div>
                    <h4 class="fw-bold text-white mb-2 fs-5">@Model.TenSan</h4>
                    <p class="text-success fw-bold mb-2 small">
                        <i class="bi bi-pentagon-fill me-1"></i>@Model.TenLoai
                    </p>
                    <div class="p-3 bg-secondary bg-opacity-10 rounded-3 border border-secondary border-opacity-25 mt-3 small">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-white-50">Đơn giá:</span>
                            <span class="fw-bold text-white">@Model.GiaTheoGio.ToString("N0") ₫/giờ</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-white-50">Địa điểm:</span>
                            <span class="text-white"><i class="bi bi-geo-alt-fill text-success me-1"></i>TP. Cần Thơ</span>
                        </div>
                    </div>
                </div>

                <!-- Panel 2: Form đặt sân -->
                <div class="bg-dark p-4 rounded-4 border border-secondary border-opacity-25 shadow-lg">
                    <h3 class="fw-bold mb-3 text-white fs-5">
                        <i class="bi bi-calendar-plus text-success me-2"></i>Thông Tin Đặt Sân
                    </h3>

                    @using (Html.BeginForm("DatSan", "DatSan", FormMethod.Post, new { id = "bookingForm" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(m => m.MaSan)
                        @Html.HiddenFor(m => m.GiaTheoGio, new { id = "GiaTheoGio" })

                        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger shadow-sm border-0 small text-white bg-danger bg-opacity-25" })

                        <!-- Ngày đặt -->
                        <div class="mb-3">
                            <label class="form-label text-white-50 small fw-bold">Ngày đặt sân</label>
                            @Html.TextBoxFor(m => m.NgayDat, "{0:yyyy-MM-dd}", new { 
                                @class = "form-control bg-dark text-white border-secondary shadow-none py-2", 
                                type = "date", 
                                min = DateTime.Today.ToString("yyyy-MM-dd"),
                                id = "NgayDat"
                            })
                            @Html.ValidationMessageFor(m => m.NgayDat, "", new { @class = "text-danger small mt-1 d-block" })
                        </div>

                        <!-- Giờ bắt đầu & Giờ kết thúc (Dropdowns) -->
                        <div class="row g-3 mb-3">
                            <div class="col-sm-6">
                                <label class="form-label text-white-50 small fw-bold">Giờ bắt đầu</label>
                                <select name="GioBatDauStr" id="GioBatDau" class="form-select bg-dark text-white border-secondary shadow-none py-2">
                                    @for (int i = 0; i < 24; i++)
                                    {
                                        string t = i.ToString("00") + ":00";
                                        <option value="@t" @(Model.GioBatDauStr == t ? "selected" : "")>@t</option>
                                    }
                                </select>
                                @Html.ValidationMessageFor(m => m.GioBatDauStr, "", new { @class = "text-danger small mt-1 d-block" })
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label text-white-50 small fw-bold">Giờ kết thúc</label>
                                <select name="GioKetThucStr" id="GioKetThuc" class="form-select bg-dark text-white border-secondary shadow-none py-2">
                                    @for (int i = 1; i <= 24; i++)
                                    {
                                        string t = i.ToString("00") + ":00";
                                        <option value="@t" @(Model.GioKetThucStr == t ? "selected" : "")>@t</option>
                                    }
                                </select>
                                @Html.ValidationMessageFor(m => m.GioKetThucStr, "", new { @class = "text-danger small mt-1 d-block" })
                            </div>
                        </div>

                        <!-- Ghi chú -->
                        <div class="mb-4">
                            <label class="form-label text-white-50 small fw-bold">Ghi chú thêm</label>
                            @Html.TextAreaFor(m => m.GhiChu, new { 
                                @class = "form-control bg-dark text-white border-secondary shadow-none", 
                                placeholder = "Ví dụ: Yêu cầu trọng tài, thuê thêm áo tập, nước...", 
                                rows = "2",
                                id = "GhiChu"
                            })
                            @Html.ValidationMessageFor(m => m.GhiChu, "", new { @class = "text-danger small mt-1 d-block" })
                        </div>

                        <!-- Price Preview Section -->
                        <div class="p-3 bg-success bg-opacity-10 border border-success border-opacity-25 rounded-3 mb-4 d-flex justify-content-between align-items-center">
                            <div>
                                <span class="d-block text-white-50 small">Tổng tiền dự kiến</span>
                                <span class="text-white-50 small" id="hour-calculation">0 giờ</span>
                            </div>
                            <div class="text-end">
                                <span class="fs-4 fw-bold text-success" id="preview-tongtien">0 ₫</span>
                            </div>
                        </div>

                        <!-- Submit Button -->
                        <button type="submit" id="btn-submit" class="btn btn-success btn-lg w-100 fw-bold py-3" style="background-color: var(--clr-primary, #16a34a); border-color: var(--clr-primary, #16a34a);">
                            <i class="bi bi-calendar-check me-2"></i>Xác nhận đặt sân
                        </button>
                    }
                </div>
            </div>

            <!-- Cột bên phải: col-lg-7 hiển thị Lịch biểu FullCalendar trực quan -->
            <div class="col-lg-7">
                <div class="bg-dark p-4 rounded-4 border border-secondary border-opacity-25 shadow-lg h-100 d-flex flex-column">
                    <h3 class="fw-bold mb-2 text-white fs-5">
                        <i class="bi bi-calendar3 text-success me-2"></i>Lịch Trực Quan Của Sân
                    </h3>
                    <p class="text-white-50 small mb-3">
                        <i class="bi bi-info-circle me-1 text-info"></i>Các ô màu đỏ biểu thị khung giờ <strong>đã bị đặt</strong>. Bạn có thể <strong>kéo chọn</strong> hoặc <strong>click chọn ô trống</strong> để tự động điền nhanh ngày/giờ vào form đặt.
                    </p>

                    <!-- Khay lịch -->
                    <div id="calendar-container" class="position-relative" style="min-height: 500px;">
                        <div id="calendar"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CSS Tinh chỉnh giao diện FullCalendar theo tông màu tối cực kỳ hiện đại -->
<style>
    #calendar {
        background-color: #1a1f26;
        border-radius: 12px;
        padding: 12px;
        border: 1px solid rgba(255, 255, 255, 0.07);
        color: #fff;
        font-family: inherit;
    }
    .fc-theme-standard td, .fc-theme-standard th {
        border-color: rgba(255, 255, 255, 0.08) !important;
    }
    .fc-theme-standard .fc-scrollgrid {
        border-color: rgba(255, 255, 255, 0.08) !important;
    }
    .fc .fc-col-header-cell-cushion {
        color: #fff;
        font-weight: 600;
        text-decoration: none;
        font-size: 13px;
    }
    .fc .fc-timegrid-slot-label-cushion {
        color: rgba(255, 255, 255, 0.6);
        font-size: 11px;
    }
    .fc .fc-timegrid-axis-cushion {
        color: rgba(255, 255, 255, 0.6);
    }
    .fc .fc-button-primary {
        background-color: #16a34a !important;
        border-color: #16a34a !important;
        color: #fff !important;
        font-weight: 600 !important;
        transition: all 0.2s ease;
        font-size: 12px;
        padding: 4px 8px;
        text-transform: capitalize;
    }
    .fc .fc-button-primary:hover {
        background-color: #15803d !important;
        border-color: #15803d !important;
        transform: translateY(-1px);
    }
    .fc .fc-button-primary:disabled {
        background-color: #374151 !important;
        border-color: #374151 !important;
    }
    .fc .fc-toolbar-title {
        font-size: 14px !important;
        font-weight: bold;
        color: #fff;
    }
    .fc-event {
        border-radius: 6px !important;
        padding: 2px 4px !important;
        font-size: 11px !important;
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
    }
    .fc-header-toolbar {
        margin-bottom: 12px !important;
    }
</style>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <!-- 1. Nhúng thư viện FullCalendar (Bản CDN JS UMD bao gồm tất cả view) -->
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js"></script>

    <script>
        $(document).ready(function () {
            // Hàm tính toán và cập nhật tổng tiền
            function updateTongTien() {
                var startVal = $('#GioBatDau').val();
                var endVal = $('#GioKetThuc').val();
                var gia = parseFloat($('#GiaTheoGio').val());

                if (startVal && endVal && !isNaN(gia)) {
                    var startHour = parseInt(startVal.split(':')[0], 10);
                    var endHour = parseInt(endVal.split(':')[0], 10);

                    if (endHour <= startHour) {
                        $('#preview-tongtien').text('0 ₫');
                        $('#hour-calculation').text('Giờ kết thúc phải lớn hơn giờ bắt đầu');
                        $('#btn-submit').prop('disabled', true);
                        return;
                    }

                    var durationHours = endHour - startHour;
                    var tongTien = durationHours * gia;

                    $('#hour-calculation').text(durationHours + ' giờ chơi');
                    $('#preview-tongtien').text(tongTien.toLocaleString('vi-VN') + ' ₫');
                    $('#btn-submit').prop('disabled', false);
                }
            }

            // Gọi lần đầu khi tải trang
            updateTongTien();

            // Lắng nghe sự kiện thay đổi giờ chơi trên Form
            $('#GioBatDau, #GioKetThuc').on('change', function () {
                updateTongTien();
            });

            // 2. Khởi tạo FullCalendar trực quan (timeGridWeek)
            var calendarEl = document.getElementById('calendar');
            var maSan = @Model.MaSan;

            var calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'timeGridWeek', // Hiển thị theo dạng tuần
                locale: 'vi',               // Ngôn ngữ Tiếng Việt
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'timeGridWeek,timeGridDay'
                },
                buttonText: {
                    today: 'Hôm nay',
                    week: 'Tuần',
                    day: 'Ngày'
                },
                slotDuration: '01:00:00',   // Chia mốc giờ 1 tiếng
                slotMinTime: '05:00:00',    // Giờ bắt đầu hoạt động của sân (5h sáng)
                slotMaxTime: '24:00:00',    // Giờ đóng cửa (12h đêm)
                allDaySlot: false,          // Tắt ô hiển thị cả ngày
                expandRows: true,           // Kéo dãn các dòng cho cân xứng
                height: 520,                // Chiều cao tối đa của lịch
                selectable: true,           // Cho phép chọn trực tiếp
                selectMirror: true,
                unselectAuto: true,
                firstDay: 1,                // Ngày bắt đầu tuần là Thứ Hai
                slotEventOverlap: false,    // Không cho phép các lịch đặt đè lên nhau

                // 3. Tải danh sách lịch đặt sân thông qua Ajax (VẤN ĐỀ 2)
                events: function(info, successCallback, failureCallback) {
                    var startStr = info.start.toISOString().split('T')[0];
                    var endStr = info.end.toISOString().split('T')[0];
                    
                    $.ajax({
                        url: '/DatSan/GetLichSanBong',
                        type: 'GET',
                        dataType: 'json',
                        data: {
                            maSan: maSan,
                            start: startStr, // FullCalendar tự sinh start/end của tuần hiện tại
                            end: endStr
                        },
                        success: function(data) {
                            successCallback(data);
                        },
                        error: function(err) {
                            console.error('Lỗi khi tải lịch đặt sân bóng:', err);
                            failureCallback(err);
                        }
                    });
                },

                // Chỉ cho phép chọn khung giờ lớn hơn hoặc bằng thời điểm hiện tại
                selectAllow: function(selectInfo) {
                    return selectInfo.start >= new Date();
                },

                // 4. Khi click chọn ô giờ trống -> Điền nhanh thông tin vào form
                select: function(info) {
                    var startDate = info.start;
                    var endDate = info.end;

                    // Không cho phép chọn quá 12 tiếng trong 1 đơn
                    var durationHours = (endDate - startDate) / 3600000;
                    if (durationHours > 12) {
                        calendar.unselect();
                        return;
                    }

                    // Chuyển đổi định dạng ngày: YYYY-MM-DD
                    var year = startDate.getFullYear();
                    var month = String(startDate.getMonth() + 1).padStart(2, '0');
                    var day = String(startDate.getDate()).padStart(2, '0');
                    var dateStr = `${year}-${month}-${day}`;

                    // Chuyển đổi định dạng giờ: HH:00
                    var startHour = String(startDate.getHours()).padStart(2, '0') + ":00";
                    var endHour = String(endDate.getHours()).padStart(2, '0') + ":00";

                    // Điền thông tin vào form
                    $('#NgayDat').val(dateStr);
                    
                    if ($(`#GioBatDau option[value="${startHour}"]`).length > 0) {
                        $('#GioBatDau').val(startHour);
                    }
                    if ($(`#GioKetThuc option[value="${endHour}"]`).length > 0) {
                        $('#GioKetThuc').val(endHour);
                    }
                    
                    // Cập nhật lại tổng tiền hiển thị
                    updateTongTien();
                    calendar.unselect();

                    // Cuộn nhẹ màn hình về phía Form đặt sân để khách hàng xác nhận
                    $('html, body').animate({
                        scrollTop: $('#bookingForm').offset().top - 80
                    }, 400);
                }
            });

            calendar.render();
        });
    </script>
}
