<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Hệ thống Quản Lý Đặt Sân Bóng</title>

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="@Url.Content("~/Content/Admindek/css/bootstrap.min.css")">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- SweetAlert2 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11.7.32/dist/sweetalert2.min.css" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Public+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="@Url.Content("~/Content/Admindek/css/custom.css")">

    <style>
        body {
            font-family: 'Public Sans', sans-serif;
        }
        /* Custom avatar badge design */
        .avatar-circle {
            width: 32px;
            height: 32px;
            background-color: #007bff;
            color: #ffffff;
            font-weight: bold;
            font-size: 0.95rem;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
        }
        /* Style fixes for admin layout */
        .nav-item.text-uppercase {
            padding: 0.75rem 1rem 0.25rem;
            font-size: 0.75rem;
            font-weight: 700;
            color: #6c757d;
        }
        .admin-sidebar .nav-link i.icon-start {
            font-size: 1.15rem;
        }
    </style>
    @RenderSection("Styles", required: false)
</head>

<body class="hold-transition sidebar-mini layout-fixed">
    <!-- Sidebar Overlay for Mobile Toggle -->
    <div class="sidebar-overlay"></div>

    <div class="wrapper">

        <!-- NAVBAR / HEADER -->
        <header class="admin-header">
            <!-- Left Header Links & Sidebar Toggles -->
            <ul class="navbar-nav d-flex flex-row align-items-center me-auto list-unstyled mb-0">
                <li class="nav-item">
                    <button class="btn btn-link d-none d-lg-inline-block text-dark" id="sidebarCollapse" role="button">
                        <i class="bi bi-list fs-4"></i>
                    </button>
                    <!-- Mobile Toggle Button -->
                    <button class="btn btn-link d-lg-none text-dark" id="sidebarToggle" role="button">
                        <i class="bi bi-list fs-4"></i>
                    </button>
                </li>
                <li class="nav-item d-none d-sm-inline-block ms-3">
                    <a href="@Url.Action("Index", "Home")" class="nav-link text-dark fw-semibold">
                        <i class="bi bi-globe me-1"></i> Xem trang chủ
                    </a>
                </li>
            </ul>

            <!-- Right Header Links -->
            <ul class="navbar-nav d-flex flex-row align-items-center ms-auto list-unstyled mb-0">
                <li class="nav-item">
                    <a class="nav-link text-dark px-3" data-widget="fullscreen" href="#" role="button" title="Toàn màn hình">
                        <i class="bi bi-arrows-fullscreen fs-5"></i>
                    </a>
                </li>

                <!-- User Profile Dropdown -->
                <li class="nav-item ms-2">
                    <div class="dropdown">
                        <a href="#" class="d-flex align-items-center text-dark text-decoration-none dropdown-toggle px-2"
                           id="dropdownUserHeader" data-bs-toggle="dropdown" aria-expanded="false">
                            <div class="avatar-circle me-2">
                                @(Session["HoTen"] != null ? Session["HoTen"].ToString().Substring(0, 1).ToUpper() : "A")
                            </div>
                            <span class="d-none d-md-inline fw-semibold">@(Session["HoTen"] ?? "Quản trị viên")</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2" aria-labelledby="dropdownUserHeader">
                            <li class="px-3 py-2 border-bottom">
                                <div class="fw-bold">@(Session["HoTen"] ?? "Quản trị viên")</div>
                                <small class="text-muted">Vai trò: @(Session["VaiTro"] ?? "Admin")</small>
                            </li>
                            <li>
                                <a class="dropdown-item py-2" href="@Url.Action("Index", "Home")">
                                    <i class="bi bi-house-door me-2 text-primary"></i> Quay lại Trang chủ
                                </a>
                            </li>
                            <li>
                                <hr class="dropdown-divider my-1">
                            </li>
                            <li>
                                @using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { id = "adminLogoutForm", @class = "d-none" }))
                                {
                                    @Html.AntiForgeryToken()
                                }
                                <a class="dropdown-item py-2 text-danger" href="javascript:void(0);" onclick="document.getElementById('adminLogoutForm').submit();">
                                    <i class="bi bi-box-arrow-right me-2"></i> Đăng xuất
                                </a>
                            </li>
                        </ul>
                    </div>
                </li>
            </ul>
        </header>

        <!-- MAIN SIDEBAR NAVIGATION -->
        <nav class="admin-sidebar d-flex flex-column">
            <!-- Brand Logo -->
            <a href="@Url.Action("Dashboard", "Admin")" class="sidebar-brand text-decoration-none py-3 d-flex align-items-center">
                <img src="@Url.Content("~/Content/Admindek/img/logo.png")" alt="Admindek Logo" class="brand-image rounded-circle"
                     style="width: 32px; height: 32px; margin-right: 10px; object-fit: contain;">
                <span class="brand-text fw-bold text-primary fs-5" style="letter-spacing: 0.5px;">Admindek</span>
            </a>

            <!-- Sidebar Items -->
            <div class="sidebar flex-grow-1 overflow-auto">
                @{
                    var action = ViewContext.RouteData.Values["action"]?.ToString().ToLower();
                    var controller = ViewContext.RouteData.Values["controller"]?.ToString().ToLower();
                }

                <ul class="nav nav-pills flex-column mb-auto px-2" role="menu">
                    <!-- Dashboard -->
                    <li class="nav-item">
                        <a href="@Url.Action("Dashboard", "Admin")" class="nav-link @(action == "dashboard" ? "active" : "")">
                            <i class="bi bi-speedometer2 icon-start"></i>
                            <p class="mb-0 d-inline-block">Tổng quan</p>
                        </a>
                    </li>

                    <li class="nav-item text-uppercase text-secondary fs-7 mt-3 px-3"><small>QUẢN LÝ HỆ THỐNG</small></li>

                    <!-- Sân Bóng -->
                    <li class="nav-item">
                        <a href="@Url.Action("Index", "Admin")" class="nav-link @(controller == "admin" && (action == "index" || action == "create" || action == "edit") ? "active" : "")">
                            <i class="bi bi-dribbble icon-start"></i>
                            <p class="mb-0 d-inline-block">Quản lý sân bóng</p>
                        </a>
                    </li>

                    <!-- Đơn Đặt Sân -->
                    <li class="nav-item">
                        <a href="@Url.Action("QuanLyDatSan", "Admin")" class="nav-link @(action == "quanlydatsan" ? "active" : "")">
                            <i class="bi bi-calendar-check icon-start"></i>
                            <p class="mb-0 d-inline-block">Quản lý đặt sân</p>
                        </a>
                    </li>

                    <!-- Khách Hàng -->
                    @if (Session["VaiTro"] != null && Session["VaiTro"].ToString() == "Admin")
                    {
                        <li class="nav-item">
                            <a href="@Url.Action("QuanLyKhachHang", "Admin")" class="nav-link @(action == "quanlykhachhang" ? "active" : "")">
                                <i class="bi bi-people icon-start"></i>
                                <p class="mb-0 d-inline-block">Quản lý khách hàng</p>
                            </a>
                        </li>
                    }

                    <li class="nav-item text-uppercase text-secondary fs-7 mt-3 px-3"><small>TÍNH NĂNG NÂNG CAO</small></li>

                    <!-- Lịch Biểu Trực Quan (FullCalendar) -->
                    <li class="nav-item">
                        <a href="@Url.Action("LichDatSan", "Admin")" class="nav-link @(action == "lichdatsan" ? "active" : "")">
                            <i class="bi bi-calendar3 icon-start"></i>
                            <p class="mb-0 d-inline-block">Lịch đặt sân</p>
                        </a>
                    </li>

                    <!-- Thống Kê & Báo Cáo (ChartJS) -->
                    <li class="nav-item">
                        <a href="@Url.Action("ThongKe", "Admin")" class="nav-link @(action == "thongke" ? "active" : "")">
                            <i class="bi bi-bar-chart-line icon-start"></i>
                            <p class="mb-0 d-inline-block">Thống kê doanh thu</p>
                        </a>
                    </li>

                    @if (Session["VaiTro"] != null && (Session["VaiTro"].ToString() == "Owner" || Session["VaiTro"].ToString() == "ChuSan"))
                    {
                        <!-- Cấu hình giá theo giờ -->
                        <li class="nav-item">
                            <a href="@Url.Action("CauHinhGia", "Admin")" class="nav-link @(action == "cauhinhgia" ? "active" : "")">
                                <i class="bi bi-currency-dollar icon-start"></i>
                                <p class="mb-0 d-inline-block">Cấu hình giá theo giờ</p>
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </nav>

        <!-- MAIN CONTENT CONTAINER -->
        <main class="admin-content">
            <div class="container-fluid">
                <!-- Global Session Alerts -->
                @if (TempData["ThanhCong"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 mb-4" role="alert" style="border-radius: 8px;">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                            <div>@TempData["ThanhCong"]</div>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (TempData["LoiThongBao"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 mb-4" role="alert" style="border-radius: 8px;">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                            <div>@TempData["LoiThongBao"]</div>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <!-- Dynamic Page Content -->
                @RenderBody()
            </div>
        </main>

        <!-- FOOTER -->
        <footer class="admin-footer">
            <div class="float-end d-none d-sm-inline">
                Hệ thống Quản lý Sân Bóng v1.0
            </div>
            <strong>Bản quyền &copy; @DateTime.Now.Year <a href="@Url.Action("Index", "Home")" class="text-decoration-none">DatSanBong.vn</a>.</strong> Bảo lưu mọi quyền.
        </footer>
    </div>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="@Url.Content("~/Content/Admindek/js/bootstrap.bundle.min.js")"></script>

    <!-- SweetAlert2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.7.32/dist/sweetalert2.all.min.js"></script>

    <!-- Custom JS -->
    <script src="@Url.Content("~/Content/Admindek/js/custom.js")"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
