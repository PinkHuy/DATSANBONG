<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Đặt sân bóng nhanh chóng, tiện lợi – DatSanBong.vn" />
    <title>@ViewBag.Title – DatSanBong</title>
    <link href="~/Content/SanBong.css" rel="stylesheet" />



    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet" />


    <style>
        :root {
            --font-main: 'Segoe UI', 'Tahoma', 'Arial', sans-serif;
            --green-dark: #0d3b2e;
            --green-main: #1a6b44;
            --green-mid: #22883a;
            --green-light: #2ecc71;
            --green-glow: #4ade80;
            --white: #ffffff;
            --gray-soft: #f4f7f5;
            --gray-text: #5a6e63;
            --shadow-card: 0 4px 24px rgba(0,0,0,0.10);
            --radius: .75rem;
            --transition: .22s cubic-bezier(.4,0,.2,1);
        }

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: var(--font-main);
            font-size: 15px;
            line-height: 1.65;
            color: #1e2d26;
            background: var(--gray-soft);
        }

        /* ── NAVBAR ─────────────────────────────────── */
        .navbar-main {
            background: linear-gradient(135deg, var(--green-dark) 0%, var(--green-main) 100%);
            padding: .85rem 0;
            position: sticky;
            top: 0;
            z-index: 1030;
            box-shadow: 0 2px 16px rgba(0,80,40,.18);
        }

        .navbar-brand {
            font-size: 1.35rem;
            font-weight: 700;
            color: var(--white) !important;
            letter-spacing: -.3px;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: .45rem;
        }

            .navbar-brand i {
                color: var(--green-glow);
                font-size: 1.5rem;
            }

        .brand-dot {
            display: inline-block;
            width: 7px;
            height: 7px;
            background: var(--green-glow);
            border-radius: 50%;
        }

        .navbar-nav .nav-link {
            color: rgba(255,255,255,.82) !important;
            font-weight: 500;
            padding: .45rem .9rem !important;
            border-radius: .5rem;
            transition: color var(--transition), background var(--transition);
            display: flex;
            align-items: center;
            gap: .35rem;
        }

            .navbar-nav .nav-link:hover,
            .navbar-nav .nav-link.active {
                color: var(--white) !important;
                background: rgba(255,255,255,.12);
            }

        .btn-nav-outline {
            border: 1.5px solid rgba(255,255,255,.55) !important;
            border-radius: .5rem !important;
            padding: .4rem .9rem !important;
        }

            .btn-nav-outline:hover {
                border-color: var(--white) !important;
                background: rgba(255,255,255,.08) !important;
            }

        .btn-nav-primary {
            background: var(--green-light) !important;
            color: var(--green-dark) !important;
            font-weight: 700 !important;
            border-radius: .5rem !important;
            padding: .4rem 1rem !important;
            transition: background var(--transition), transform var(--transition);
        }

            .btn-nav-primary:hover {
                background: var(--green-glow) !important;
                transform: translateY(-1px);
            }

        .user-avatar {
            width: 34px;
            height: 34px;
            background: var(--green-light);
            color: var(--green-dark);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: .92rem;
        }

        .dropdown-menu {
            border-radius: var(--radius) !important;
            border: none !important;
            box-shadow: var(--shadow-card) !important;
            font-family: var(--font-main);
        }

        /* ── MAIN ───────────────────────────────────── */
        main {
            min-height: calc(100vh - 240px);
        }

        /* Alert */
        .alert {
            border-radius: var(--radius);
            border: none;
            font-weight: 500;
        }

        /* ── FOOTER ─────────────────────────────────── */
        .site-footer {
            background: linear-gradient(135deg, #0a2d1f 0%, var(--green-dark) 100%);
            color: rgba(255,255,255,.75);
            padding: 3rem 0 1.5rem;
            margin-top: 4rem;
        }

        .footer-brand {
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--white);
        }

            .footer-brand i {
                color: var(--green-glow);
            }

        .site-footer a {
            color: rgba(255,255,255,.62);
            text-decoration: none;
            transition: color var(--transition);
        }

            .site-footer a:hover {
                color: var(--green-glow);
            }

        .social-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: rgba(255,255,255,.08);
            font-size: 1rem;
            transition: background var(--transition), color var(--transition);
        }

            .social-icon:hover {
                background: var(--green-light) !important;
                color: var(--green-dark) !important;
            }

        .footer-divider {
            border-color: rgba(255,255,255,.12);
            margin: 1.5rem 0 1rem;
        }

        /* ── RESPONSIVE ─────────────────────────────── */
        .navbar-toggler {
            color: var(--white);
        }

            .navbar-toggler:focus {
                box-shadow: none;
            }

        @@media (max-width: 991px) {
            .navbar-collapse {
                background: rgba(10,45,31,.97);
                border-radius: var(--radius);
                padding: 1rem;
                margin-top: .5rem;
            }
        }
    </style>

    @Styles.Render("~/Content/css")
    <link href="~/Content/Site.css" rel="stylesheet" />
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>

    <!-- ═══ NAVBAR ═══════════════════════════════════════════ -->
    <nav class="navbar navbar-main navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand" href="@Url.Action("Index", "Home")">
                <i class="bi bi-dribbble"></i>
                DatSanBong<span class="brand-dot ms-1"></span>
            </a>

            <button class="navbar-toggler border-0" type="button"
                    data-bs-toggle="collapse" data-bs-target="#mainNav"
                    aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <i class="bi bi-list fs-4"></i>
            </button>

            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Home")">
                            <i class="bi bi-house"></i>Trang chủ
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "SanBong")">
                            <i class="bi bi-grid"></i>Danh sách sân
                        </a>
                    </li>
                    @if (Session["VaiTro"] != null && Session["VaiTro"].ToString() == "Admin")
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Index", "Admin")">
                                <i class="bi bi-speedometer2"></i>Dashboard
                            </a>
                        </li>
                    }
                </ul>

                <ul class="navbar-nav ms-auto align-items-center gap-2">
                    @if (Session["MaND"] != null)
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("LichSu", "DatSan")">
                                <i class="bi bi-clock-history"></i>Lịch sử đặt sân
                            </a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#"
                               id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <div class="user-avatar">
                                    @(Session["HoTen"]?.ToString().Substring(0, 1).ToUpper())
                                </div>
                                <span class="d-none d-lg-inline text-white">@Session["HoTen"]</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" style="min-width:200px">
                                <li class="px-3 py-2 border-bottom">
                                    <div class="fw-semibold">@Session["HoTen"]</div>
                                    <small class="text-muted">@Session["VaiTro"]</small>
                                </li>
                                @if (Session["VaiTro"].ToString() == "Admin")
                                {
                                    <li>
                                        <a class="dropdown-item" href="@Url.Action("Index", "Admin")">
                                            <i class="bi bi-speedometer2 me-2 text-success"></i>Dashboard
                                        </a>
                                    </li>
                                }
                                <li>
                                    <a class="dropdown-item" href="@Url.Action("LichSu", "DatSan")">
                                        <i class="bi bi-clock-history me-2 text-success"></i>Lịch sử đặt sân
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    @using (Html.BeginForm("DangXuat", "Account", FormMethod.Post, new { @class = "d-inline" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger">
                                            <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                                        </button>
                                    }
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link btn-nav-outline" href="@Url.Action("DangNhap", "Account")">
                                <i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link btn-nav-primary" href="@Url.Action("DangKy", "Account")">
                                <i class="bi bi-person-plus me-1"></i>Đăng ký
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- ═══ MAIN CONTENT ════════════════════════════════════ -->
    <main>
        @if (TempData["ThanhCong"] != null)
        {
            <div class="container mt-3">
                <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>@TempData["ThanhCong"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        }
        @if (TempData["LoiThongBao"] != null)
        {
            <div class="container mt-3">
                <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                    <i class="bi bi-exclamation-circle-fill me-2"></i>@TempData["LoiThongBao"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            </div>
        }

        @RenderBody()
    </main>

    <!-- ═══ FOOTER ═══════════════════════════════════════════ -->
    <footer class="site-footer">
        <div class="container">
            <div class="row g-4 mb-4">
                <div class="col-12 col-md-4">
                    <div class="footer-brand mb-2">
                        <i class="bi bi-dribbble me-2"></i>DatSanBong
                    </div>
                    <p class="small mb-3">
                        Nền tảng đặt sân bóng trực tuyến hàng đầu.<br>
                        Nhanh chóng, tiện lợi, an toàn.
                    </p>
                    <div class="d-flex gap-2">
                        <a href="#" class="social-icon"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="social-icon"><i class="bi bi-youtube"></i></a>
                        <a href="#" class="social-icon"><i class="bi bi-instagram"></i></a>
                    </div>
                </div>
                <div class="col-6 col-md-2">
                    <h6 class="text-white fw-bold mb-3">Khám phá</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-1"><a href="@Url.Action("Index","Home")">Trang chủ</a></li>
                        <li class="mb-1"><a href="@Url.Action("Index","SanBong")">Danh sách sân</a></li>
                    </ul>
                </div>
                <div class="col-6 col-md-3">
                    <h6 class="text-white fw-bold mb-3">Liên hệ</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-1"><i class="bi bi-telephone me-2"></i>0901 234 567</li>
                        <li class="mb-1"><i class="bi bi-envelope me-2"></i>info@datsanbong.vn</li>
                        <li class="mb-1"><i class="bi bi-geo-alt me-2"></i>TP. Hồ Chí Minh</li>
                    </ul>
                </div>
            </div>
            <hr class="footer-divider" />
            <div class="text-center small">
                &copy; @DateTime.Now.Year DatSanBong. Bản quyền thuộc về DatSanBong.vn
            </div>
        </div>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("Scripts", required: false)

    <!-- ✅ Áp dụng font đã lưu trong Settings -->
    <script>(function () {
            var font = localStorage.getItem('dsb-font');
            if (font === 'courier') {
                document.body.classList.add('font-courier');
            }
        })();</script>

</body>
</html>
