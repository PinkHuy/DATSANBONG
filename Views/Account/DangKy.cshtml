@model DATSANBONG.Models.RegisterViewModel
@{
    ViewBag.Title = "Đăng Ký | DatSanBong";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="auth-page">
    <div class="container">
        <div class="row justify-content-center align-items-center min-vh-80">
            <div class="col-12 col-md-6 col-lg-5">
                <div class="auth-card">
                    <!-- Icon -->
                    <div class="auth-icon">
                        <i class="bi bi-person-plus"></i>
                    </div>
                    <h2 class="auth-title">Tạo Tài Khoản</h2>
                    <p class="auth-subtitle">Tham gia cộng đồng DatSanBong ngay hôm nay!</p>

                    @using (Html.BeginForm("DangKy", "Account", FormMethod.Post, new { @class = "auth-form" }))
                    {
                        @Html.AntiForgeryToken()

                        <div class="form-floating mb-3">
                            @Html.TextBoxFor(m => m.HoTen, new { @class = "form-control", placeholder = "Họ và tên", id = "regHoTen", autocomplete = "name" })
                            <label for="regHoTen"><i class="bi bi-person-badge me-1"></i>Họ và tên</label>
                            @Html.ValidationMessageFor(m => m.HoTen, "", new { @class = "text-danger small d-block" })
                        </div>

                        <div class="form-floating mb-3">
                            @Html.TextBoxFor(m => m.TaiKhoan, new { @class = "form-control", placeholder = "Tài khoản", id = "regTaiKhoan", autocomplete = "username" })
                            <label for="regTaiKhoan"><i class="bi bi-at me-1"></i>Tài khoản</label>
                            @Html.ValidationMessageFor(m => m.TaiKhoan, "", new { @class = "text-danger small d-block" })
                        </div>

                        <div class="form-floating mb-3 position-relative">
                            @Html.PasswordFor(m => m.MatKhau, new { @class = "form-control pe-5", placeholder = "Mật khẩu", id = "regMatKhau", autocomplete = "new-password" })
                            <label for="regMatKhau"><i class="bi bi-lock me-1"></i>Mật khẩu</label>
                            <button type="button" class="btn-toggle-pass" onclick="togglePassword('regMatKhau', this)" tabindex="-1">
                                <i class="bi bi-eye"></i>
                            </button>
                            @Html.ValidationMessageFor(m => m.MatKhau, "", new { @class = "text-danger small d-block" })
                        </div>

                        <div class="form-floating mb-3 position-relative">
                            @Html.PasswordFor(m => m.XacNhanMatKhau, new { @class = "form-control pe-5", placeholder = "Xác nhận mật khẩu", id = "regXacNhan", autocomplete = "new-password" })
                            <label for="regXacNhan"><i class="bi bi-lock-fill me-1"></i>Xác nhận mật khẩu</label>
                            <button type="button" class="btn-toggle-pass" onclick="togglePassword('regXacNhan', this)" tabindex="-1">
                                <i class="bi bi-eye"></i>
                            </button>
                            @Html.ValidationMessageFor(m => m.XacNhanMatKhau, "", new { @class = "text-danger small d-block" })
                        </div>

                        <div class="form-floating mb-4">
                            @Html.TextBoxFor(m => m.SoDienThoai, new { @class = "form-control", placeholder = "Số điện thoại", id = "regSDT", type = "tel", autocomplete = "tel" })
                            <label for="regSDT"><i class="bi bi-telephone me-1"></i>Số điện thoại <span class="text-muted">(tuỳ chọn)</span></label>
                            @Html.ValidationMessageFor(m => m.SoDienThoai, "", new { @class = "text-danger small d-block" })
                        </div>

                        <!-- Strength indicator -->
                        <div class="password-strength mb-3" id="strengthBar" style="display:none">
                            <div class="strength-label"><span>Độ mạnh mật khẩu:</span> <strong id="strengthText"></strong></div>
                            <div class="strength-track">
                                <div class="strength-fill" id="strengthFill"></div>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-success btn-auth w-100" id="btnDangKy">
                            <i class="bi bi-person-check me-2"></i>Đăng Ký
                        </button>
                    }

                    <hr class="my-4">
                    <p class="text-center mb-0">
                        Đã có tài khoản?
                        <a href="@Url.Action("DangNhap", "Account")" class="auth-link fw-semibold">Đăng nhập</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        function togglePassword(id, btn) {
            var input = document.getElementById(id);
            var icon = btn.querySelector('i');
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.replace('bi-eye', 'bi-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.replace('bi-eye-slash', 'bi-eye');
            }
        }

        // Password strength meter
        document.getElementById('regMatKhau').addEventListener('input', function () {
            var val = this.value;
            var bar = document.getElementById('strengthBar');
            var fill = document.getElementById('strengthFill');
            var text = document.getElementById('strengthText');
            if (val.length === 0) { bar.style.display = 'none'; return; }
            bar.style.display = 'block';

            var score = 0;
            if (val.length >= 8) score++;
            if (/[A-Z]/.test(val)) score++;
            if (/[0-9]/.test(val)) score++;
            if (/[^A-Za-z0-9]/.test(val)) score++;

            var levels = [
                { label: 'Rất yếu', color: '#ef4444', width: '25%' },
                { label: 'Yếu',     color: '#f97316', width: '50%' },
                { label: 'Trung bình', color: '#eab308', width: '75%' },
                { label: 'Mạnh',    color: '#22c55e', width: '100%' }
            ];
            var lvl = levels[Math.min(score, 3)];
            fill.style.width = lvl.width;
            fill.style.backgroundColor = lvl.color;
            text.textContent = lvl.label;
            text.style.color = lvl.color;
        });
    </script>
}
