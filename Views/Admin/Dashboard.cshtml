@{
    ViewBag.Title = "Dashboard - Tổng quan";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    
    bool isAdmin = Session["VaiTro"] != null && Session["VaiTro"].ToString() == "Admin";
    string cardColClass = isAdmin ? "col-12 col-sm-6 col-xl-3" : "col-12 col-sm-6 col-xl-4";
    string linkColClass = isAdmin ? "col-12 col-md-4" : "col-12 col-md-6";
}

<!-- Page Header in Admindek Style -->
<div class="page-header-blue d-flex justify-content-between align-items-center">
    <div>
        <h4 class="mb-0 fw-bold">Tổng quan Dashboard</h4>
        <p class="text-muted mb-0 small">Chào mừng trở lại, <strong>@Session["HoTen"]</strong>! Đây là báo cáo nhanh về hệ thống đặt sân bóng hôm nay.</p>
    </div>
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="#">Trang chủ</a></li>
            <li class="breadcrumb-item active" aria-current="page">Dashboard</li>
        </ol>
    </nav>
</div>

<!-- Stats Cards Row -->
<div class="row g-4 mb-4">
    <!-- Card: Tổng Sân Bóng -->
    <div class="@cardColClass">
        <div class="card border-0 shadow-sm h-100 bg-info text-white">
            <div class="card-body p-4 d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="fw-bold mb-1">@ViewBag.TongSan</h2>
                    <p class="mb-0 text-white-50 small fw-semibold text-uppercase">Sân Bóng</p>
                </div>
                <div class="fs-1 text-white-50">
                    <i class="bi bi-dribbble"></i>
                </div>
            </div>
            <a href="@Url.Action("Index", "Admin")" class="card-footer bg-dark bg-opacity-10 border-0 py-2.5 text-center text-white text-decoration-none small">
                Chi tiết sân bóng <i class="bi bi-arrow-right-circle ms-1"></i>
            </a>
        </div>
    </div>

    <!-- Card: Tổng Khách Hàng (Chỉ Admin) -->
    @if (isAdmin)
    {
        <div class="@cardColClass">
            <div class="card border-0 shadow-sm h-100 bg-success text-white">
                <div class="card-body p-4 d-flex justify-content-between align-items-center">
                    <div>
                        <h2 class="fw-bold mb-1">@ViewBag.TongKhach</h2>
                        <p class="mb-0 text-white-50 small fw-semibold text-uppercase">Khách Hàng</p>
                    </div>
                    <div class="fs-1 text-white-50">
                        <i class="bi bi-people"></i>
                    </div>
                </div>
                <a href="@Url.Action("QuanLyKhachHang", "Admin")" class="card-footer bg-dark bg-opacity-10 border-0 py-2.5 text-center text-white text-decoration-none small">
                    Chi tiết khách hàng <i class="bi bi-arrow-right-circle ms-1"></i>
                </a>
            </div>
        </div>
    }

    <!-- Card: Tổng Đơn Đặt -->
    <div class="@cardColClass">
        <div class="card border-0 shadow-sm h-100 bg-warning text-dark">
            <div class="card-body p-4 d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="fw-bold mb-1">@ViewBag.TongDon</h2>
                    <p class="mb-0 text-dark-50 small fw-semibold text-uppercase">Đơn Đặt Sân</p>
                </div>
                <div class="fs-1 text-dark-50">
                    <i class="bi bi-calendar-check"></i>
                </div>
            </div>
            <a href="@Url.Action("QuanLyDatSan", "Admin")" class="card-footer bg-dark bg-opacity-10 border-0 py-2.5 text-center text-dark text-decoration-none small">
                Duyệt đơn đặt sân <i class="bi bi-arrow-right-circle ms-1"></i>
            </a>
        </div>
    </div>

    <!-- Card: Tổng Doanh Thu -->
    <div class="@cardColClass">
        <div class="card border-0 shadow-sm h-100 bg-danger text-white">
            <div class="card-body p-4 d-flex justify-content-between align-items-center">
                <div>
                    <h2 class="fw-bold mb-1">@String.Format("{0:N0}", ViewBag.DoanhThu) <span style="font-size: 0.6em;">đ</span></h2>
                    <p class="mb-0 text-white-50 small fw-semibold text-uppercase">Doanh Thu</p>
                </div>
                <div class="fs-1 text-white-50">
                    <i class="bi bi-cash-stack"></i>
                </div>
            </div>
            <a href="@Url.Action("ThongKe", "Admin")" class="card-footer bg-dark bg-opacity-10 border-0 py-2.5 text-center text-white text-decoration-none small">
                Xem biểu đồ thống kê <i class="bi bi-arrow-right-circle ms-1"></i>
            </a>
        </div>
    </div>
</div>

<!-- Table: 5 Đơn đặt sân mới nhất -->
<div class="row">
    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white d-flex align-items-center justify-content-between py-3">
                <h5 class="mb-0 text-dark fw-bold">
                    <i class="bi bi-clock-history text-primary me-2"></i>5 Đơn Đặt Sân Mới Nhất
                </h5>
                <a href="@Url.Action("QuanLyDatSan", "Admin")" class="btn btn-outline-primary btn-sm px-3">
                    Xem tất cả <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
            
            <div class="card-block p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4" style="width: 60px;">#</th>
                                <th>Khách hàng</th>
                                <th>Sân bóng</th>
                                <th>Ngày chơi</th>
                                <th>Khung giờ</th>
                                <th class="text-end">Tổng tiền</th>
                                <th class="text-center pe-4" style="width: 150px;">Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (ViewBag.DonMoiNhat != null && ((IEnumerable<DATSANBONG.Models.DatSan>)ViewBag.DonMoiNhat).Any())
                            {
                                int stt = 1;
                                foreach (var don in (IEnumerable<DATSANBONG.Models.DatSan>)ViewBag.DonMoiNhat)
                                {
                                    <tr>
                                        <td class="ps-4 fw-bold text-muted">@stt</td>
                                        <td>
                                            <div class="fw-bold text-dark">@(don.NguoiDung != null ? don.NguoiDung.HoTen : "N/A")</div>
                                            <div class="small text-muted">@(don.NguoiDung != null ? don.NguoiDung.SoDienThoai : "")</div>
                                        </td>
                                        <td class="fw-bold text-success">@(don.SanBong != null ? don.SanBong.TenSan : "N/A")</td>
                                        <td>@don.NgayDat.ToString("dd/MM/yyyy")</td>
                                        <td>
                                            @don.GioBatDau.ToString(@"hh\:mm") - @don.GioKetThuc.ToString(@"hh\:mm")
                                        </td>
                                        <td class="fw-bold text-danger text-end">
                                            @String.Format("{0:N0}", don.TongTien) VNĐ
                                        </td>
                                        <td class="text-center pe-4">
                                            @if (don.TrangThai == "Đã duyệt")
                                            {
                                                <span class="badge bg-success-light text-success border border-success border-opacity-25 px-2.5 py-1.5 fw-semibold">
                                                    Đã duyệt
                                                </span>
                                            }
                                            else if (don.TrangThai == "Chờ duyệt")
                                            {
                                                <span class="badge bg-warning-light text-warning border border-warning border-opacity-25 px-2.5 py-1.5 fw-semibold">
                                                    Chờ duyệt
                                                </span>
                                            }
                                            else if (don.TrangThai == "Đã hủy")
                                            {
                                                <span class="badge bg-danger-light text-danger border border-danger border-opacity-25 px-2.5 py-1.5 fw-semibold">
                                                    Đã hủy
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                    stt++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-5 text-muted">
                                        <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                        Chưa có đơn đặt sân nào mới
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Quick Admin Links -->
<div class="row mt-4 g-4">
    <div class="col-12 @linkColClass">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-4 text-center">
                <div class="fs-2 text-success mb-2">
                    <i class="bi bi-dribbble"></i>
                </div>
                <h6 class="fw-bold mb-2">Quản lý Sân Bóng</h6>
                <p class="text-muted small mb-3">Thêm mới, sửa đổi thông tin các sân bóng, cập nhật giá giờ thuê và trạng thái.</p>
                <a href="@Url.Action("Index", "Admin")" class="btn btn-outline-success btn-sm w-100">Xem ngay</a>
            </div>
        </div>
    </div>
    @if (isAdmin)
    {
        <div class="col-12 @linkColClass">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4 text-center">
                    <div class="fs-2 text-primary mb-2">
                        <i class="bi bi-people"></i>
                    </div>
                    <h6 class="fw-bold mb-2">Quản lý Khách Hàng</h6>
                    <p class="text-muted small mb-3">Quản lý danh sách tài khoản khách hàng, thông tin liên lạc và quyền truy cập.</p>
                    <a href="@Url.Action("QuanLyKhachHang", "Admin")" class="btn btn-outline-primary btn-sm w-100">Xem ngay</a>
                </div>
            </div>
        </div>
    }
    <div class="col-12 @linkColClass">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body p-4 text-center">
                <div class="fs-2 text-warning mb-2">
                    <i class="bi bi-calendar-check"></i>
                </div>
                <h6 class="fw-bold mb-2">Quản lý Đơn Đặt</h6>
                <p class="text-muted small mb-3">Xem và xét duyệt đơn đặt sân của khách hàng, phê duyệt hoặc từ chối hủy đặt lịch.</p>
                <a href="@Url.Action("QuanLyDatSan", "Admin")" class="btn btn-outline-warning btn-sm w-100">Xem ngay</a>
            </div>
        </div>
    </div>
</div>
