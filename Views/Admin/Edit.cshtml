@model DATSANBONG.Models.SanBong

@{
    ViewBag.Title = "Chỉnh sửa sân bóng";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- Page Header in Admindek Style -->
<div class="page-header-blue d-flex justify-content-between align-items-center">
    <div>
        <h4 class="mb-0 fw-bold">Chỉnh sửa sân bóng</h4>
        <p class="text-muted mb-0 small">Thay đổi thông tin sân bóng <strong>@Model.TenSan</strong>.</p>
    </div>
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="@Url.Action("Dashboard")">Dashboard</a></li>
            <li class="breadcrumb-item"><a href="@Url.Action("Index")">Sân bóng</a></li>
            <li class="breadcrumb-item active" aria-current="page">Chỉnh sửa</li>
        </ol>
    </nav>
</div>

<!-- Edit Form Card -->
<div class="row">
    <div class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-pencil-square me-2 text-primary"></i>Thông tin cập nhật</h6>
            </div>
            <div class="card-body p-4">
                @using (Html.BeginForm("Edit", "Admin", FormMethod.Post, new { enctype = "multipart/form-data" }))
                {
                    @Html.AntiForgeryToken()
                    <!-- Keep primary key and old image name hidden -->
                    @Html.HiddenFor(model => model.MaSan)
                    @Html.HiddenFor(model => model.HinhAnh)

                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger border-0 mb-4", style = "border-radius: 8px;" })

                    <!-- Tên Sân -->
                    <div class="mb-4">
                        @Html.LabelFor(model => model.TenSan, "Tên sân bóng", new { @class = "form-label fw-bold text-muted small" })
                        @Html.TextBoxFor(model => model.TenSan, new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.TenSan, "", new { @class = "text-danger small mt-1 d-block" })
                    </div>

                    <div class="row">
                        <!-- Loại Sân Dropdown -->
                        <div class="col-md-6 mb-4">
                            @Html.LabelFor(model => model.MaLoai, "Loại sân (Kích thước)", new { @class = "form-label fw-bold text-muted small" })
                            @Html.DropDownList("MaLoai", null, new { @class = "form-select" })
                            @Html.ValidationMessageFor(model => model.MaLoai, "", new { @class = "text-danger small mt-1 d-block" })
                        </div>

                        <!-- Giá Theo Giờ -->
                        <div class="col-md-6 mb-4">
                            @Html.LabelFor(model => model.GiaTheoGio, "Giá thuê theo giờ", new { @class = "form-label fw-bold text-muted small" })
                            <div class="input-group">
                                @Html.TextBoxFor(model => model.GiaTheoGio, new { @class = "form-control", type = "number", min = "0", step = "1000" })
                                <span class="input-group-text bg-light text-muted">VNĐ</span>
                            </div>
                            @Html.ValidationMessageFor(model => model.GiaTheoGio, "", new { @class = "text-danger small mt-1 d-block" })
                        </div>
                    </div>

                    <!-- Trạng Thái Dropdown -->
                    <div class="mb-4">
                        @Html.LabelFor(model => model.TrangThai, "Trạng thái hoạt động", new { @class = "form-label fw-bold text-muted small" })
                        @Html.DropDownListFor(model => model.TrangThai, new List<SelectListItem>
                        {
                            new SelectListItem { Text = "Hoạt động", Value = "Hoạt động" },
                            new SelectListItem { Text = "Ngưng hoạt động", Value = "Ngưng hoạt động" }
                        }, new { @class = "form-select" })
                        @Html.ValidationMessageFor(model => model.TrangThai, "", new { @class = "text-danger small mt-1 d-block" })
                    </div>

                    <!-- Sân Cha (Cấu hình Cụm Sân) -->
                    <div class="mb-4">
                        @Html.LabelFor(model => model.MaSanCha, "Thuộc sân lớn (Nếu sân này là sân con bên trong)", new { @class = "form-label fw-bold text-muted small" })
                        @Html.DropDownList("MaSanCha", null, "-- Sân độc lập (Không thuộc sân nào) --", new { @class = "form-select" })
                        @Html.ValidationMessageFor(model => model.MaSanCha, "", new { @class = "text-danger small mt-1 d-block" })
                        <div class="form-text text-muted small mt-1">Lưu ý: Chọn sân lớn nếu sân này nằm bên trong một sân bóng lớn khác (ví dụ: sân 5 người con nằm trong sân 11 người cha).</div>
                    </div>

                    <!-- Image Display and Upload -->
                    <div class="mb-4">
                        <label class="form-label fw-bold text-muted small d-block">Hình ảnh hiện tại</label>
                        <div class="mb-3 p-2 border border-dashed rounded d-inline-block bg-light">
                            @if (!string.IsNullOrEmpty(Model.HinhAnh))
                            {
                                <img src="~/Content/Images/SanBong/@Model.HinhAnh" alt="@Model.TenSan" style="max-height: 120px; width: auto; object-fit: cover;" class="img-fluid rounded" />
                            }
                            else
                            {
                                <span class="text-muted small italic p-3 d-inline-block">Không có hình ảnh</span>
                            }
                        </div>
                        
                        <label class="form-label fw-bold text-muted small d-block" for="fileAnh">Thay đổi hình ảnh mới (Bỏ qua nếu giữ ảnh cũ)</label>
                        <input type="file" name="fileAnh" id="fileAnh" class="form-control" accept="image/*" />
                        <div class="form-text text-muted small mt-1">Định dạng hỗ trợ: jpg, jpeg, png. Dung lượng tối đa: 5MB.</div>
                    </div>

                    <hr class="my-4 text-muted" />

                    <!-- Actions -->
                    <div class="d-flex gap-2 justify-content-end">
                        <a href="@Url.Action("Index")" class="btn btn-outline-secondary px-4">
                            <i class="bi bi-x-circle me-1.5"></i>Hủy bỏ
                        </a>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold">
                            <i class="bi bi-save me-1.5"></i>Lưu thay đổi
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Info Side Widget -->
    <div class="col-12 col-lg-4">
        <div class="card border-0 shadow-sm bg-light-blue text-dark mb-4">
            <div class="card-body p-4">
                <h6 class="fw-bold mb-3 text-primary"><i class="bi bi-info-circle-fill me-2"></i>Lưu ý khi cập nhật</h6>
                <ul class="list-unstyled small mb-0">
                    <li class="mb-2"><i class="bi bi-check2-circle text-success me-2"></i>Khi đổi hình ảnh mới, hình ảnh cũ trong thư mục hệ thống vẫn sẽ được giữ lại, và cơ sở dữ liệu sẽ cập nhật liên kết của hình ảnh mới.</li>
                    <li class="mb-0"><i class="bi bi-check2-circle text-success me-2"></i>Nếu chuyển trạng thái sang <strong>Ngưng hoạt động</strong>, sân bóng sẽ ẩn đi khỏi màn hình tìm kiếm đặt sân của khách hàng ở trang chủ.</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
