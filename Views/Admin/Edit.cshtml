@model DATSANBONG.Models.SanBong

@{
    ViewBag.Title = "Chỉnh sửa sân bóng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Chỉnh sửa sân bóng: @Model.TenSan</h4>
        </div>
        <div class="card-body">
            @using (Html.BeginForm("Edit", "Admin", FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                @Html.AntiForgeryToken()
                <!-- Giữ lại khóa chính và ảnh cũ -->
                @Html.HiddenFor(model => model.MaSan)
                @Html.HiddenFor(model => model.HinhAnh)
                
                <div class="row justify-content-center">
                    <div class="col-md-8">
                        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                        <div class="mb-3">
                            @Html.LabelFor(model => model.TenSan, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.EditorFor(model => model.TenSan, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.TenSan, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(model => model.MaLoai, "Loại sân", htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.DropDownList("MaLoai", null, htmlAttributes: new { @class = "form-select" })
                            @Html.ValidationMessageFor(model => model.MaLoai, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(model => model.GiaTheoGio, htmlAttributes: new { @class = "form-label fw-bold" })
                            <div class="input-group">
                                @Html.EditorFor(model => model.GiaTheoGio, new { htmlAttributes = new { @class = "form-control", type = "number", min = "0", step = "1000" } })
                                <span class="input-group-text">VNĐ</span>
                            </div>
                            @Html.ValidationMessageFor(model => model.GiaTheoGio, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(model => model.TrangThai, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.EditorFor(model => model.TrangThai, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.TrangThai, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Hình ảnh hiện tại</label>
                            <br />
                            <div class="mb-2 p-2 border rounded d-inline-block bg-light">
                                @if (!string.IsNullOrEmpty(Model.HinhAnh))
                                {
                                    <img src="~/Content/Images/SanBong/@Model.HinhAnh" alt="@Model.TenSan" style="max-height: 150px; width: auto;" class="img-fluid" />
                                }
                                else
                                {
                                    <span class="text-muted">Không có ảnh</span>
                                }
                            </div>
                            
                            <label class="form-label fw-bold d-block mt-2">Đổi hình ảnh mới (Bỏ qua nếu muốn giữ ảnh cũ)</label>
                            <input type="file" name="fileAnh" class="form-control" accept="image/*" />
                        </div>

                        <div class="mb-4 mt-4 text-end">
                            <a href="@Url.Action("Index")" class="btn btn-outline-secondary me-2">Hủy bỏ</a>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i> Cập nhật
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
