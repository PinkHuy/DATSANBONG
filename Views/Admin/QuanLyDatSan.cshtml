@model List<DATSANBONG.Models.DatSan>

@{
    ViewBag.Title = "Quản lý đơn đặt sân";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var currentFilter = ViewBag.TrangThaiChon as string;
}

<!-- Page Header in Admindek Style -->
<div class="page-header-blue d-flex justify-content-between align-items-center">
    <div>
        <h4 class="mb-0 fw-bold">Quản lý đơn đặt sân</h4>
        <p class="text-muted mb-0 small">Duyệt hoặc hủy các yêu cầu thuê sân bóng từ khách hàng.</p>
    </div>
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="@Url.Action("Dashboard")">Dashboard</a></li>
            <li class="breadcrumb-item active" aria-current="page">Đơn đặt sân</li>
        </ol>
    </nav>
</div>

<!-- Status Filter Component -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white py-3">
        <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-funnel me-2 text-primary"></i>Bộ lọc đơn hàng</h6>
    </div>
    <div class="card-body py-3">
        <form method="get" action="@Url.Action("QuanLyDatSan", "Admin")" class="row g-3 align-items-center">
            <div class="col-auto">
                <label class="col-form-label fw-semibold text-muted">Trạng thái đơn:</label>
            </div>
            <div class="col-auto">
                <select name="trangThai" class="form-select" onchange="this.form.submit()">
                    <option value="" @(string.IsNullOrEmpty(currentFilter) ? "selected" : "")>-- Tất cả trạng thái --</option>
                    <option value="Chờ duyệt" @(currentFilter == "Chờ duyệt" ? "selected" : "")>Chờ duyệt</option>
                    <option value="Đã duyệt" @(currentFilter == "Đã duyệt" ? "selected" : "")>Đã duyệt</option>
                    <option value="Đã hủy" @(currentFilter == "Đã hủy" ? "selected" : "")>Đã hủy</option>
                </select>
            </div>
        </form>
    </div>
</div>

<!-- Bookings Card Table -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white d-flex align-items-center justify-content-between py-3">
        <h5 class="mb-0 text-dark fw-bold">
            <i class="bi bi-calendar-check-fill text-success me-2"></i>Danh sách đơn đặt sân
        </h5>
    </div>
    
    <div class="card-block p-0">
        @if (Model == null || !Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-calendar-x fs-1 text-warning mb-3 d-block"></i>
                <h5 class="fw-bold">Không tìm thấy đơn đặt sân nào</h5>
                <p class="small mb-0">Hệ thống chưa ghi nhận đơn hàng nào phù hợp với bộ lọc đã chọn.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Khách hàng</th>
                            <th>Sân bóng</th>
                            <th>Ngày chơi</th>
                            <th>Khung giờ</th>
                            <th class="text-end">Thành tiền</th>
                            <th class="text-center">Trạng thái</th>
                            <th class="text-center pe-4" style="width: 200px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <!-- Customer Info -->
                                <td class="ps-4">
                                    <div class="fw-bold text-dark">@(item.NguoiDung != null ? item.NguoiDung.HoTen : "N/A")</div>
                                    <div class="small text-muted">
                                        <i class="bi bi-telephone me-1"></i>@(item.NguoiDung != null ? item.NguoiDung.SoDienThoai : "N/A")
                                    </div>
                                </td>
                                <!-- Pitch Info -->
                                <td>
                                    <div class="fw-bold text-success">@(item.SanBong != null ? item.SanBong.TenSan : "N/A")</div>
                                    <div class="small text-muted">
                                        <i class="bi bi-tag me-1"></i>@(item.SanBong != null && item.SanBong.LoaiSan != null ? item.SanBong.LoaiSan.TenLoai : "N/A")
                                    </div>
                                </td>
                                <!-- Playing Date -->
                                <td>
                                    @item.NgayDat.ToString("dd/MM/yyyy")
                                </td>
                                <!-- Booking Time Slot -->
                                <td class="fw-bold">
                                    @{
                                        string startStr = item.GioBatDau.ToString(@"hh\:mm");
                                        string endStr = (item.GioKetThuc.Hours == 23 && item.GioKetThuc.Minutes == 59) ? "24:00" : item.GioKetThuc.ToString(@"hh\:mm");
                                    }
                                    @startStr - @endStr
                                </td>
                                <!-- Total Amount -->
                                <td class="text-end fw-bold text-danger">
                                    @(item.TongTien.HasValue ? item.TongTien.Value.ToString("N0") + " VNĐ" : "—")
                                </td>
                                <!-- Status Badge -->
                                <td class="text-center">
                                    @if (item.TrangThai == "Chờ duyệt")
                                    {
                                        <span class="badge bg-warning-light text-warning border border-warning border-opacity-25 px-2.5 py-1.5 fw-semibold">
                                            Chờ duyệt
                                        </span>
                                    }
                                    else if (item.TrangThai == "Đã duyệt")
                                    {
                                        <span class="badge bg-success-light text-success border border-success border-opacity-25 px-2.5 py-1.5 fw-semibold">
                                            Đã duyệt
                                        </span>
                                    }
                                    else if (item.TrangThai == "Đã hủy")
                                    {
                                        <span class="badge bg-danger-light text-danger border border-danger border-opacity-25 px-2.5 py-1.5 fw-semibold">
                                            Đã hủy
                                        </span>
                                    }
                                </td>
                                <!-- Approval Actions -->
                                <td class="text-center pe-4">
                                    @if (item.TrangThai == "Chờ duyệt")
                                    {
                                        <div class="d-flex gap-1.5 justify-content-center">
                                            <a href="@Url.Action("DuyetDon", "Admin", new { id = item.MaDatSan })" 
                                               class="btn btn-success btn-sm px-2.5 py-1.5 fw-semibold" 
                                               onclick="return confirm('Bạn có chắc muốn PHÊ DUYỆT đơn đặt sân này không?');">
                                                <i class="bi bi-check-lg"></i> Duyệt
                                            </a>
                                            <a href="@Url.Action("HuyDon", "Admin", new { id = item.MaDatSan })" 
                                               class="btn btn-outline-danger btn-sm px-2.5 py-1.5 fw-semibold" 
                                               onclick="return confirm('Bạn có chắc muốn HỦY đơn đặt sân này không?');">
                                                <i class="bi bi-x-lg"></i> Hủy
                                            </a>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small italic"><i class="bi bi-lock-fill me-1"></i>Đã xử lý</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
