@model DATSANBONG.Models.SanBong

@{
    ViewBag.Title = "Thêm mới sân bóng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-success text-white">
            <h4 class="mb-0">Thêm mới sân bóng</h4>
        </div>
        <div class="card-body">
            @using (Html.BeginForm("Create", "Admin", FormMethod.Post, new { enctype = "multipart/form-data" })) 
            {
                @Html.AntiForgeryToken()
                
                <div class="row justify-content-center">
                    <div class="col-md-8">
                        <!-- Hiển thị lỗi chung -->
                        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                        <div class="mb-3">
                            @Html.LabelFor(model => model.TenSan, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.EditorFor(model => model.TenSan, new { htmlAttributes = new { @class = "form-control", placeholder = "Nhập tên sân bóng..." } })
                            @Html.ValidationMessageFor(model => model.TenSan, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(model => model.MaLoai, "Loại sân", htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.DropDownList("MaLoai", null, "--- Chọn loại sân ---", htmlAttributes: new { @class = "form-select" })
                            @Html.ValidationMessageFor(model => model.MaLoai, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(model => model.GiaTheoGio, htmlAttributes: new { @class = "form-label fw-bold" })
                            <div class="input-group">
                                @Html.EditorFor(model => model.GiaTheoGio, new { htmlAttributes = new { @class = "form-control", type = "number", min = "0", step = "1000", placeholder = "Ví dụ: 150000" } })
                                <span class="input-group-text">VNĐ</span>
                            </div>
                            @Html.ValidationMessageFor(model => model.GiaTheoGio, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(model => model.TrangThai, htmlAttributes: new { @class = "form-label fw-bold" })
                            @Html.EditorFor(model => model.TrangThai, new { htmlAttributes = new { @class = "form-control", placeholder = "Trống / Đang bảo trì..." } })
                            @Html.ValidationMessageFor(model => model.TrangThai, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Hình ảnh</label>
                            <!-- Input để upload file ảnh -->
                            <input type="file" name="fileAnh" class="form-control" accept="image/*" />
                            <small class="form-text text-muted">Hỗ trợ các định dạng .jpg, .png, .jpeg</small>
                        </div>

                        <div class="mb-4 mt-4 text-end">
                            <a href="@Url.Action("Index")" class="btn btn-outline-secondary me-2">Hủy bỏ</a>
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-save"></i> Lưu thông tin
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <!-- Kích hoạt kiểm tra validation phía client -->
    @Scripts.Render("~/bundles/jqueryval")
}
