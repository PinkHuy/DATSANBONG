@model DATSANBONG.Models.SanBong

@{
    ViewBag.Title = "Thêm sân bóng mới";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-0">
                <div class="card-header bg-success text-white py-3">
                    <h5 class="card-title mb-0 fw-bold">
                        <i class="bi bi-plus-circle me-1"></i>Thêm Sân Bóng Mới
                    </h5>
                </div>
                <div class="card-body p-4">
                    @using (Html.BeginForm("Create", "Admin", FormMethod.Post, new { enctype = "multipart/form-data", id = "createFieldForm" }))
                    {
                        @Html.AntiForgeryToken()

                        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

                        <!-- Tên Sân -->
                        <div class="mb-3">
                            @Html.LabelFor(model => model.TenSan, new { @class = "form-label fw-bold" })
                            @Html.TextBoxFor(model => model.TenSan, new { @class = "form-control", placeholder = "Nhập tên sân bóng..." })
                            @Html.ValidationMessageFor(model => model.TenSan, "", new { @class = "text-danger small" })
                        </div>

                        <!-- Loại Sân Dropdown -->
                        <div class="mb-3">
                            @Html.LabelFor(model => model.MaLoai, new { @class = "form-label fw-bold" })
                            @Html.DropDownList("MaLoai", null, "-- Chọn loại sân --", new { @class = "form-select" })
                            @Html.ValidationMessageFor(model => model.MaLoai, "", new { @class = "text-danger small" })
                        </div>

                        <!-- Giá Theo Giờ -->
                        <div class="mb-3">
                            @Html.LabelFor(model => model.GiaTheoGio, new { @class = "form-label fw-bold" })
                            @Html.TextBoxFor(model => model.GiaTheoGio, new { @class = "form-control", type = "number", min = "0", step = "1000", placeholder = "Ví dụ: 150000" })
                            @Html.ValidationMessageFor(model => model.GiaTheoGio, "", new { @class = "text-danger small" })
                        </div>

                        <!-- File Upload Hình Ảnh -->
                        <div class="mb-3">
                            <label class="form-label fw-bold" for="fileAnh">Hình ảnh sân bóng</label>
                            <input type="file" name="fileAnh" id="fileAnh" class="form-control" accept="image/*" />
                            <div class="form-text">Định dạng hỗ trợ: jpg, jpeg, png. Dung lượng tối đa: 5MB.</div>
                        </div>

                        <!-- Trạng Thái Dropdown -->
                        <div class="mb-3">
                            @Html.LabelFor(model => model.TrangThai, new { @class = "form-label fw-bold" })
                            @Html.DropDownListFor(model => model.TrangThai, new List<SelectListItem>
                            {
                                new SelectListItem { Text = "Hoạt động", Value = "Hoạt động", Selected = true },
                                new SelectListItem { Text = "Ngưng hoạt động", Value = "Ngưng hoạt động" }
                            }, new { @class = "form-select" })
                            @Html.ValidationMessageFor(model => model.TrangThai, "", new { @class = "text-danger small" })
                        </div>

                        <hr class="my-4" />

                        <!-- Nút hành động -->
                        <div class="d-flex gap-2 justify-content-end">
                            <a href="@Url.Action("Index", "Admin")" class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle me-1"></i>Hủy bỏ
                            </a>
                            <button type="submit" class="btn btn-success px-4">
                                <i class="bi bi-save me-1"></i>Lưu thông tin
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
