@model IEnumerable<DATSANBONG.Models.SanBong>

@{
    ViewBag.Title = "Cấu hình giá theo giờ";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- Page Header in Admindek Style -->
<div class="page-header-blue d-flex justify-content-between align-items-center">
    <div>
        <h4 class="mb-0 fw-bold">Cấu hình giá theo giờ</h4>
        <p class="text-muted mb-0 small">Thay đổi nhanh giá thuê sân bóng theo giờ bằng công cụ AJAX tiện lợi.</p>
    </div>
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="@Url.Action("Dashboard")">Giao diện Admin</a></li>
            <li class="breadcrumb-item active" aria-current="page">Cấu hình giá</li>
        </ol>
    </nav>
</div>

<!-- Main Card Component -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
        <h5 class="mb-0 text-dark fw-bold">
            <i class="bi bi-currency-dollar text-primary me-2"></i>Danh sách sân bóng & Cập nhật giá thuê
        </h5>
    </div>
    
    <div class="card-block p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4" style="width: 100px;">Mã Sân</th>
                        <th>Tên Sân</th>
                        <th>Loại Sân</th>
                        <th style="width: 250px;">Giá thuê hiện tại (VNĐ/Giờ)</th>
                        <th style="width: 300px;">Giá thuê mới</th>
                        <th class="text-center pe-4" style="width: 180px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr id="row-@item.MaSan">
                                <td class="ps-4 fw-bold text-muted">#@item.MaSan</td>
                                <td class="fw-bold text-dark">@item.TenSan</td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        @(item.LoaiSan != null ? item.LoaiSan.TenLoai : "Chưa phân loại")
                                    </span>
                                </td>
                                <td class="fw-bold text-danger fs-6 current-price">
                                    @String.Format("{0:N0}", item.GiaTheoGio) đ
                                </td>
                                <td>
                                    <div class="input-group input-group-sm w-75">
                                        <input type="number" class="form-control new-price-input" 
                                               value="@Convert.ToInt32(item.GiaTheoGio)" 
                                               min="0" step="1000" data-masan="@item.MaSan" />
                                        <span class="input-group-text bg-light text-dark">VNĐ</span>
                                    </div>
                                </td>
                                <td class="text-center pe-4">
                                    <button type="button" class="btn btn-success btn-sm px-3 btn-update-price" data-masan="@item.MaSan">
                                        <i class="bi bi-save me-1"></i> Lưu giá
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                Bạn chưa quản lý sân bóng nào trong hệ thống
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.btn-update-price').click(function () {
                var btn = $(this);
                var maSan = btn.data('masan');
                var row = $('#row-' + maSan);
                var input = row.find('.new-price-input');
                var giaMoi = input.val();

                if (!giaMoi || parseFloat(giaMoi) < 0) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Lỗi nhập liệu',
                        text: 'Vui lòng nhập giá thuê hợp lệ (>= 0).',
                        confirmButtonColor: '#3085d6'
                    });
                    return;
                }

                btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> Đang xử lý...');

                $.ajax({
                    url: '@Url.Action("CapNhatGia", "Admin")',
                    type: 'POST',
                    data: {
                        maSan: maSan,
                        giaMoi: giaMoi
                    },
                    success: function (res) {
                        btn.prop('disabled', false).html('<i class="bi bi-save me-1"></i> Lưu giá');
                        if (res.success) {
                            // Cập nhật hiển thị giá hiện tại
                            var formattedPrice = parseFloat(giaMoi).toLocaleString('vi-VN') + ' đ';
                            row.find('.current-price').text(formattedPrice);
                            
                            // Hiển thị thông báo thành công dạng Toast
                            const Toast = Swal.mixin({
                                toast: true,
                                position: 'top-end',
                                showConfirmButton: false,
                                timer: 3000,
                                timerProgressBar: true,
                                didOpen: (toast) => {
                                    toast.addEventListener('mouseenter', Swal.stopTimer)
                                    toast.addEventListener('mouseleave', Swal.resumeTimer)
                                }
                            });
                            Toast.fire({
                                icon: 'success',
                                title: res.message
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Thất bại',
                                text: res.message,
                                confirmButtonColor: '#3085d6'
                            });
                        }
                    },
                    error: function () {
                        btn.prop('disabled', false).html('<i class="bi bi-save me-1"></i> Lưu giá');
                        Swal.fire({
                            icon: 'error',
                            title: 'Lỗi hệ thống',
                            text: 'Không thể kết nối đến máy chủ. Vui lòng thử lại sau.',
                            confirmButtonColor: '#d33'
                        });
                    }
                });
            });
        });
    </script>
}
