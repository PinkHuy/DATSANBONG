@model List<DATSANBONG.Models.NguoiDung>

@{
    ViewBag.Title = "Quản lý khách hàng";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- Page Header in Admindek Style -->
<div class="page-header-blue d-flex justify-content-between align-items-center">
    <div>
        <h4 class="mb-0 fw-bold">Quản lý khách hàng</h4>
        <p class="text-muted mb-0 small">Danh sách khách hàng đăng ký tài khoản trên hệ thống.</p>
    </div>
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="@Url.Action("Dashboard")">Dashboard</a></li>
            <li class="breadcrumb-item active" aria-current="page">Khách hàng</li>
        </ol>
    </nav>
</div>

<!-- Customers Card Table -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white d-flex align-items-center justify-content-between py-3">
        <h5 class="mb-0 text-dark fw-bold">
            <i class="bi bi-people-fill text-primary me-2"></i>Danh sách khách hàng
        </h5>
    </div>
    
    <div class="card-block p-0">
        @if (Model == null || !Model.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-people fs-1 text-warning mb-3 d-block"></i>
                <h5 class="fw-bold">Chưa có khách hàng nào</h5>
                <p class="small mb-0">Hệ thống chưa ghi nhận tài khoản khách hàng nào được tạo.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4" style="width: 80px;">STT</th>
                            <th>Họ tên</th>
                            <th>Tên tài khoản</th>
                            <th>Số điện thoại</th>
                            <th>Vai trò</th>
                            <th class="text-center pe-4" style="width: 150px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int stt = 1;
                        }
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-muted">#@stt</td>
                                <td>
                                    <div class="fw-bold text-dark">@item.HoTen</div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border px-2.5 py-1.5 fw-semibold">
                                        @item.TaiKhoan
                                    </span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.SoDienThoai))
                                    {
                                        <span><i class="bi bi-telephone text-muted me-1.5"></i>@item.SoDienThoai</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small italic">Chưa cung cấp</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-info-light text-info border border-info border-opacity-25 px-2.5 py-1.5 fw-semibold">
                                        @item.VaiTro
                                    </span>
                                </td>
                                <td class="text-center pe-4">
                                    <a href="@Url.Action("XoaKhachHang", "Admin", new { id = item.MaND })" 
                                       class="btn btn-outline-danger btn-sm px-2.5 py-1.5 fw-semibold" 
                                       onclick="return confirm('Bạn có chắc chắn muốn XÓA khách hàng này khỏi hệ thống không? Dữ liệu không thể phục hồi!');">
                                        <i class="bi bi-trash me-1"></i> Xóa
                                    </a>
                                </td>
                            </tr>
                            stt++;
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
