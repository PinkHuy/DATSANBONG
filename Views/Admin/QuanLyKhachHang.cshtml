@model List<DATSANBONG.Models.NguoiDung>

@{
    ViewBag.Title = "Quản lý khách hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0 text-dark">
            <i class="bi bi-people-fill text-primary me-2"></i>Quản Lý Khách Hàng
        </h2>
        <a href="@Url.Action("Dashboard", "Admin")" class="btn btn-outline-secondary">
            <i class="bi bi-speedometer2 me-1"></i>Về Dashboard
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info text-center py-5 shadow-sm border-0 rounded-3">
            <i class="bi bi-people fs-1 text-info mb-3 d-block"></i>
            <h5 class="fw-bold">Chưa có khách hàng nào</h5>
            <p class="text-muted mb-0">Hệ thống chưa ghi nhận tài khoản khách hàng nào.</p>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4" style="width: 80px;">STT</th>
                                <th>Họ tên</th>
                                <th>Tài khoản</th>
                                <th>Số điện thoại</th>
                                <th>Vai trò</th>
                                <th class="text-center pe-4" style="width: 150px;">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int stt = 1;
                            }
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold text-muted">@stt</td>
                                    <td>
                                        <div class="fw-bold text-dark">@item.HoTen</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border px-2 py-1">@item.TaiKhoan</span>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.SoDienThoai))
                                        {
                                            <span><i class="bi bi-telephone me-1 text-muted"></i>@item.SoDienThoai</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted italic">Chưa cung cấp</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-info text-dark">@item.VaiTro</span>
                                    </td>
                                    <td class="text-center pe-4">
                                        <a href="@Url.Action("XoaKhachHang", "Admin", new { id = item.MaND })" 
                                           class="btn btn-outline-danger btn-sm fw-bold px-3" 
                                           onclick="return confirm('Bạn có chắc chắn muốn XÓA khách hàng này khỏi hệ thống không? Dữ liệu không thể phục hồi!');">
                                            <i class="bi bi-trash me-1"></i>Xóa
                                        </a>
                                    </td>
                                </tr>
                                stt++;
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
